{
    "name": "makeroi/laravel-analitycs",
    "version": "0.3.20",
    "description": "Конфигурируемая таблица аналитики (columns/filters/detail) для SPA во фрейме",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Leonid Dyukov",
            "email": "l.dyukov@makeroi.ru"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "makeroi/laravel-package-tools": "^1.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Makeroi\\Analitics\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Makeroi\\Analitics\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Makeroi\\Analitics\\AnaliticsServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://g.makeroi.dev/api/v4/group/95/-/packages/composer/packages.json"
        }
    ],
    "config": {
        "sort-packages": true,
        "gitlab-domains": [
            "g.makeroi.dev"
        ],
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
